# The Margin is infrastructure-only in V2.2 Stage A and must remain disabled.
MARGIN_ENABLED=false

# Supabase public credentials. These are safe for server-side approved-content reads.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose this value through NEXT_PUBLIC_* variables.
SUPABASE_SECRET_KEY=
TEFF_STUDIO_ADMIN_EMAILS=

# Reserved for the future public submission gateway. No widget or endpoint exists yet.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
