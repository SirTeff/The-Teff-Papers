# Public approved Margin notes. Disabled by default.
MARGIN_ENABLED=false

# Public visitor submission gateway. Requires MARGIN_ENABLED=true and all
# server protections below. Disabled independently by default.
MARGIN_SUBMISSIONS_ENABLED=false

# Supabase public credentials. These are safe for server-side approved-content reads.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose this value through NEXT_PUBLIC_* variables.
SUPABASE_SECRET_KEY=
TEFF_STUDIO_ADMIN_EMAILS=

# Stage D visitor verification and durable rate-limit HMAC secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
MARGIN_RATE_LIMIT_SECRET=
